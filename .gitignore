# PDF mockups (optional — remove these lines if you want PDFs tracked)
*.pdf
# ...kecuali CAD sumber siteplan: bahan skrip di tools/siteplan/, harus ikut
# supaya siteplan bisa dibuat ulang dari repo saja.
!tools/siteplan/**/cad/*.pdf
# ...dan kecuali pricelist hasil bangun: file inilah yang dipakai tombol
# "Download Pricelist" di /download/. Tanpa baris ini, PDF proyek baru
# diam-diam tidak ikut ter-commit oleh workflow Pricelist (git add tidak
# menyentuh file yang diabaikan) — dan tombolnya 404 di produksi.
!download/PriceList_*.pdf

# Node (if ever used)
node_modules/

# Internal documentation (not for deployment)
/*.md
!/README.md

# Design agent working files (not for deployment)
.agents/
**/.agents/


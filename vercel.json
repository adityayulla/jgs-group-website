{
  "trailingSlash": true,
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "(www\\.)?tentremjiwo\\.id" }],
      "destination": "https://jogjagrahaselaras.com/tentrem-jiwo/",
      "permanent": true
    },
    {
      "source": "/tentremjiwo",
      "destination": "/tentrem-jiwo/",
      "permanent": true
    },
    {
      "source": "/tentremjiwo/(.*)",
      "destination": "/tentrem-jiwo/",
      "permanent": true
    },
    {
      "source": "/kawa-village",
      "destination": "/kawa-living/",
      "permanent": true
    },
    {
      "source": "/kawa-village/(.*)",
      "destination": "/kawa-living/",
      "permanent": true
    },
    {
      "source": "/perumahan/kawa-village",
      "destination": "/kawa-living/",
      "permanent": true
    },
    {
      "source": "/perumahan/kawa-village/(.*)",
      "destination": "/kawa-living/",
      "permanent": true
    },
    {
      "source": "/perumahan/(.*)",
      "destination": "/perumahan-jogja/",
      "permanent": true
    },
    {
      "source": "/category/(.*)",
      "destination": "/perumahan-jogja/",
      "permanent": true
    },
    {
      "source": "/wp-content/(.*)",
      "destination": "/perumahan-jogja/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/(.*)\\.(css|js)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/tentrem-jiwo/img/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    }
  ]
}
